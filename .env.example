# WhatsApp API Server Environment Configuration

# Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# API Security
API_KEY=your-super-secret-api-key-here
JWT_SECRET=your-jwt-secret-key-for-sessions

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WhatsApp Configuration
WHATSAPP_SESSION_NAME=default-session
WHATSAPP_HEADLESS=true
WHATSAPP_DEVTOOLS=false

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Database Configuration (if using)
# DATABASE_URL=postgresql://username:password@localhost:5432/whatsapp_api
# REDIS_URL=redis://localhost:6379

# SSL Configuration
SSL_ENABLED=false
SSL_CERT_PATH=ssl/cert.pem
SSL_KEY_PATH=ssl/key.pem

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# CORS Configuration
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# Session Configuration
SESSION_SECRET=your-session-secret-key
SESSION_MAX_AGE=86400000

# Webhook Configuration (optional)
WEBHOOK_URL=
WEBHOOK_SECRET=

# Message Configuration
DEFAULT_MESSAGE_DELAY=1000
BULK_MESSAGE_DELAY=2000
MAX_BULK_RECIPIENTS=50

# Monitoring Configuration
HEALTH_CHECK_PATH=/health
METRICS_ENABLED=false

# Development Configuration
DEBUG_MODE=false
VERBOSE_LOGGING=false

# Docker Configuration
DOCKER_INTERNAL_PORT=3000
NGINX_PORT=80
NGINX_SSL_PORT=443

# Backup Configuration
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP=false
BACKUP_INTERVAL=24h

# Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CSP_ENABLED=true

# Performance Configuration
CLUSTER_MODE=false
CLUSTER_WORKERS=auto
COMPRESSION_ENABLED=true

# Notification Configuration
ADMIN_EMAIL=admin@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Third-party Integrations
GOOGLE_SHEETS_API_KEY=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Student Management Configuration
STUDENT_IMPORT_ENABLED=true
STUDENT_EXPORT_ENABLED=true
BULK_IMPORT_MAX_SIZE=1000
STUDENT_DATA_ENCRYPTION=false

# Feature Flags
FEATURE_MEDIA_MESSAGES=true
FEATURE_BULK_MESSAGING=true
FEATURE_STUDENT_MANAGEMENT=true
FEATURE_MESSAGE_TEMPLATES=true
FEATURE_ANALYTICS=false
FEATURE_CHATBOT=false