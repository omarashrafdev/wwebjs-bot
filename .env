# WhatsApp API Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# API Security (optional)
API_KEY=your-api-key-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=10485760
RATE_LIMIT_MAX_REQUESTS=100

# WhatsApp Configuration
WHATSAPP_SESSION_NAME=appwrite-session
WHATSAPP_HEADLESS=true
WHATSAPP_DEVTOOLS=false

# Chrome Executable Path (optional - leave empty to use bundled Chromium)
# For macOS (development):
CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# For Windows (production):
# CHROME_EXECUTABLE_PATH=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe

# Message Configuration
DEFAULT_MESSAGE_DELAY=1000
BULK_MESSAGE_DELAY=2000
MAX_BULK_RECIPIENTS=5000

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# CORS Configuration
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# Session Configuration
SESSION_SECRET=d2592dd570845fdc2fa7c6246f841286
SESSION_MAX_AGE=86400000

# Message Configuration
DEFAULT_MESSAGE_DELAY=1000
BULK_MESSAGE_DELAY=2000
MAX_BULK_RECIPIENTS=50

# Monitoring Configuration
HEALTH_CHECK_PATH=/health
METRICS_ENABLED=false

# Development Configuration
DEBUG_MODE=false
VERBOSE_LOGGING=false

# Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CSP_ENABLED=true

# Performance Configuration
CLUSTER_MODE=false
CLUSTER_WORKERS=auto
COMPRESSION_ENABLED=true

# Feature Flags
FEATURE_MEDIA_MESSAGES=true
FEATURE_BULK_MESSAGING=true
FEATURE_STUDENT_MANAGEMENT=true
FEATURE_MESSAGE_TEMPLATES=true
FEATURE_ANALYTICS=false
FEATURE_CHATBOT=false

# Appwrite Function Runtime
APPWRITE_FUNCTION_RUNTIME_NAME=node-18.0
APPWRITE_FUNCTION_RUNTIME_VERSION=18.0