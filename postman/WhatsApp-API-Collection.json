{
  "info": {
    "name": "WhatsApp API Server",
    "description": "Comprehensive API collection for WhatsApp Web.js server with student management integration capabilities.",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "Base URL for the WhatsApp API server"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string",
      "description": "API key for authentication (leave empty if not using API key auth)"
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set timestamp for requests",
          "pm.globals.set('timestamp', new Date().toISOString());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Server Management",
      "description": "Endpoints for server health and status checks",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Check if the server is running and healthy"
          },
          "response": []
        },
        {
          "name": "API Documentation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api"
              ]
            },
            "description": "Get API documentation and available endpoints"
          },
          "response": []
        }
      ]
    },
    {
      "name": "WhatsApp Client Management",
      "description": "Endpoints for managing WhatsApp client connection and status",
      "item": [
        {
          "name": "Get WhatsApp Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/whatsapp/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "whatsapp",
                "status"
              ]
            },
            "description": "Get current WhatsApp client connection status"
          },
          "response": []
        },
        {
          "name": "Get QR Code",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/whatsapp/qr",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "whatsapp",
                "qr"
              ]
            },
            "description": "Get QR code for WhatsApp authentication (if available)"
          },
          "response": []
        },
        {
          "name": "Restart WhatsApp Client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/whatsapp/restart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "whatsapp",
                "restart"
              ]
            },
            "description": "Restart the WhatsApp client connection"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Message Sending",
      "description": "Endpoints for sending different types of messages",
      "item": [
        {
          "name": "Send Single Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"+201234567890\",\n  \"message\": \"Hello! This is a test message from the WhatsApp API server.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/whatsapp/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "whatsapp",
                "send"
              ]
            },
            "description": "Send a single text message to a phone number"
          },
          "response": []
        },
        {
          "name": "Send Message to Egyptian Number (Local Format)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"01234567890\",\n  \"message\": \"Hello! This message is sent to an Egyptian number in local format.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/whatsapp/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "whatsapp",
                "send"
              ]
            },
            "description": "Send a message to an Egyptian number using local format (will be auto-converted to +20 format)"
          },
          "response": []
        },
        {
          "name": "Send Bulk Messages (Student Example)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contacts\": [\n    {\n      \"number\": \"+201234567890\",\n      \"name\": \"Ahmed Hassan\",\n      \"studentId\": \"ST001\",\n      \"class\": \"Grade 10A\",\n      \"grade\": \"85\"\n    },\n    {\n      \"number\": \"+201234567891\",\n      \"name\": \"Fatima Ali\",\n      \"studentId\": \"ST002\",\n      \"class\": \"Grade 10A\",\n      \"grade\": \"92\"\n    },\n    {\n      \"number\": \"+201234567892\",\n      \"name\": \"Omar Khaled\",\n      \"studentId\": \"ST003\",\n      \"class\": \"Grade 10B\",\n      \"grade\": \"78\"\n    }\n  ],\n  \"message\": \"Dear {name}, \\n\\nYour exam results are now available:\\n- Student ID: {studentId}\\n- Class: {class}\\n- Grade: {grade}%\\n\\nCongratulations on your performance!\\n\\nBest regards,\\nSchool Administration\",\n  \"options\": {\n    \"delay\": 3000\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/whatsapp/send-bulk",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "whatsapp",
                "send-bulk"
              ]
            },
            "description": "Send personalized bulk messages to multiple students with template variables"
          },
          "response": []
        },
        {
          "name": "Send Class Announcement (Bulk)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contacts\": [\n    {\n      \"number\": \"+201111111111\",\n      \"name\": \"Sarah Ahmed\",\n      \"class\": \"Grade 11A\"\n    },\n    {\n      \"number\": \"+201222222222\",\n      \"name\": \"Mohamed Ali\",\n      \"class\": \"Grade 11A\"\n    },\n    {\n      \"number\": \"+201333333333\",\n      \"name\": \"Layla Hassan\",\n      \"class\": \"Grade 11A\"\n    }\n  ],\n  \"message\": \"📢 Important Announcement for {class}\\n\\nDear {name},\\n\\nPlease be informed that tomorrow's math exam has been postponed to next Wednesday at 10:00 AM.\\n\\nMake sure to:\\n✅ Review chapters 5-8\\n✅ Bring your calculator\\n✅ Arrive 15 minutes early\\n\\nGood luck with your studies!\\n\\n📚 Academic Office\",\n  \"options\": {\n    \"delay\": 2500\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/whatsapp/send-bulk",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "whatsapp",
                "send-bulk"
              ]
            },
            "description": "Send class announcement to all students in a specific grade"
          },
          "response": []
        },
        {
          "name": "Send Media Message (Document)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "number",
                  "value": "+201234567890",
                  "type": "text"
                },
                {
                  "key": "message",
                  "value": "Here is your grade report for this semester. Please review and contact us if you have any questions.",
                  "type": "text"
                },
                {
                  "key": "media",
                  "type": "file",
                  "src": "/path/to/your/document.pdf"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/whatsapp/send-media",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "whatsapp",
                "send-media"
              ]
            },
            "description": "Send a message with media attachment (document, image, video, audio)"
          },
          "response": []
        },
        {
          "name": "Send Image with Caption",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "number",
                  "value": "+201234567890",
                  "type": "text"
                },
                {
                  "key": "message",
                  "value": "📸 School Event Photo - Science Fair 2025! Great job everyone! 🎉",
                  "type": "text"
                },
                {
                  "key": "media",
                  "type": "file",
                  "src": "/path/to/your/image.jpg"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/whatsapp/send-media",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "whatsapp",
                "send-media"
              ]
            },
            "description": "Send an image with caption text"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Contact & Chat Management",
      "description": "Endpoints for managing contacts and chats",
      "item": [
        {
          "name": "Get All Chats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/whatsapp/chats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "whatsapp",
                "chats"
              ]
            },
            "description": "Get all WhatsApp chats with basic information"
          },
          "response": []
        },
        {
          "name": "Get All Contacts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/whatsapp/contacts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
