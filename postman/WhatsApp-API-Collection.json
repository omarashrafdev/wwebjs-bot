                "contacts"
              ]
            },
            "description": "Get all WhatsApp contacts"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Testing & Examples",
      "description": "Example requests for testing different scenarios",
      "item": [
        {
          "name": "Test Invalid Phone Number",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"invalid-number\",\n  \"message\": \"This should fail validation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/whatsapp/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "whatsapp",
                "send"
              ]
            },
            "description": "Test validation with invalid phone number format"
          },
          "response": []
        },
        {
          "name": "Test Empty Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"+201234567890\",\n  \"message\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/whatsapp/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
