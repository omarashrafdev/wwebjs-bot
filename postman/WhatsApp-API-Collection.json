              ],
              "path": [
                "api",
                "whatsapp",
                "send"
              ]
            },
            "description": "Test with a long message (within character limit)"
          },
          "response": []
        },
        {
          "name": "Test Bulk with Invalid JSON",
          "request": {
            "method": "POST",
